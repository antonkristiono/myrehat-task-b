# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# Dipakai next.config.ts untuk rewrite /rpc + /api/auth di sisi server.
# URL, bukan rahasia — tandai public supaya tidak dianggap secret oleh leak scan.
# @public @optional @type=url
SERVER_URL=

# OpenRouter dipakai webhook WAHA. Tanpa key, concierge memakai fallback reply,
# jadi keduanya opsional supaya `next build` tidak gagal saat key belum diisi.
# @optional
OPENROUTER_API_KEY=

# @optional
OPENROUTER_MODEL=google/gemini-2.5-flash
